<odoo>
    <data>

        <!-- Parts asked for -->
        <record id="infinity_spare_requested_view_list" model="ir.ui.view">
            <field name="name">infinity.technical.report.spare.requested.list</field>
            <field name="model">infinity.technical.report.spare.requested</field>
            <field name="arch" type="xml">
                <!-- These tables sit two to a row on the Technical Report,
                     so every column is sharing half a sheet. The widths below
                     add up to that half: the two text columns take what they
                     need and the quantity takes the strip it needs and no
                     more. -->
                <list editable="bottom">
                    <field name="product_id" width="35%"/>
                    <field name="description" readonly="1" width="45%"/>
                    <field name="qty" width="20%"/>
                </list>
            </field>
        </record>

        <record id="infinity_spare_requested_view_form" model="ir.ui.view">
            <field name="name">infinity.technical.report.spare.requested.form</field>
            <field name="model">infinity.technical.report.spare.requested</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="product_id"/>
                                <field name="description" readonly="1"/>
                            </group>
                            <group>
                                <field name="qty"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Parts that actually went in -->
        <record id="infinity_spare_installed_view_list" model="ir.ui.view">
            <field name="name">infinity.technical.report.spare.installed.list</field>
            <field name="model">infinity.technical.report.spare.installed</field>
            <field name="arch" type="xml">
                <!-- Five columns in half a sheet: the numbers and the unit
                     are short and are kept short, so the part number and its
                     description keep most of the room. -->
                <list editable="bottom">
                    <field name="product_id" width="26%"/>
                    <field name="description" readonly="1" width="30%"/>
                    <field name="uom_id" readonly="1" width="14%"/>
                    <field name="qty" width="12%"/>
                    <field name="part_source" width="18%"/>
                </list>
            </field>
        </record>

        <record id="infinity_spare_installed_view_form" model="ir.ui.view">
            <field name="name">infinity.technical.report.spare.installed.form</field>
            <field name="model">infinity.technical.report.spare.installed</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="product_id"/>
                                <field name="description" readonly="1"/>
                                <field name="uom_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="qty"/>
                                <field name="part_source"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
