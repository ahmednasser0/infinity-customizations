<odoo>
    <data>

        <record id="infinity_hr_employee_view_form_inherit" model="ir.ui.view">
            <field name="name">hr.employee.form.infinity</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='job_title']" position="after">
                    <field name="actual_engineer_ids"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
