<odoo>
    <data>

        <record id="infinity_res_partner_view_form_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.infinity</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- The other names this contact goes by, above the Tax ID -->
                <xpath expr="//field[@name='vat']" position="before">
                    <field name="infinity_arabic_name" required="1"/>
                    <field name="infinity_abbreviation"/>
                </xpath>

                <!-- and the document it comes with, under the tags -->
                <xpath expr="//field[@name='category_id']" position="after">
                    <field name="infinity_attachment_name" invisible="1"/>
                    <field name="infinity_attachment" required="1"
                           filename="infinity_attachment_name"/>
                </xpath>

                <!-- Demanded on the form rather than on the fields. These
                     belong to Odoo, and a required field wants a NOT NULL
                     column over a table that has held partners since long
                     before anybody asked them for an address - the
                     constraint could never be added, and every upgrade
                     would log the failure. The form is where the answer is
                     actually being asked for, and the only place where a
                     person is the one answering. -->
                <xpath expr="//field[@name='street']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='city']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='state_id']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='zip']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='country_id']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='category_id']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>

                <!-- A company is not set up until somebody at it can be
                     reached, so the Contacts tab has to have something in
                     it before the first save. Anything in it counts - a
                     person or an address - and on a company Odoo's own
                     default for the tab is a contact person anyway.

                     Asked of a company only: the tab shows for an
                     individual too, and a plain required would refuse
                     every person ever entered as a customer.

                     company_type and not is_company, which is what 0.91
                     wrote and why 0.91 did nothing. is_company appears in
                     the partner form exactly once, inside the kanban
                     embedded in this very field, so the form's own records
                     never carry it - and a modifier naming a field the
                     view does not load evaluates to nothing, which reads
                     as 'not required' and lets every save through, person
                     and company alike. company_type is the field the form
                     actually holds; it is what the Individual / Company
                     radio writes.

                     For a one2many Odoo marks the field unset when it is
                     required and the list is empty, the same as it does
                     for a Char - see _checkValidity in web's
                     relational_model/record.js. -->
                <xpath expr="//field[@name='child_ids']" position="attributes">
                    <attribute name="required">company_type == 'company'</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
